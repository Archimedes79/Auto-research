"""D16: documents (not protected) that name the removed tick features, reconcile or the handover block. Run from the repository root AFTER the tools are deployed."""
import re

NL = "\n"


def edit(path, pairs):
    s = open(path, encoding="utf-8").read()
    for old, new in pairs:
        assert s.count(old) == 1, (path, old[:70])
        s = s.replace(old, new, 1)
    open(path, "w", encoding="utf-8", newline=NL).write(s)
    print("edited", path)


# prompts/loop.md: the wake-up paragraph
p = "autoresearch/prompts/loop.md"
s = open(p, encoding="utf-8").read()
a = s.index("- `wsl python3 ../autoresearch/tools/tick.py --handover`")
b = s.index("- do by hand what the tick lists")
s = s[:a] + ("- `wsl python3 ../autoresearch/tools/schedule.py show` and `ledger.py tail --loop <NN>` (state is read from the run records; run them in the WSL, the namespace of the launchers), then "
             "`tick.py` to start ready items that have a command (a chain of `run.py --after` launchers is the same thing by hand); read the open decisions" + NL) + s[b:]
s = s.replace("- do by hand what the tick lists as \"needs the lead\":", "- do what needs a chat:")
open(p, "w", encoding="utf-8", newline=NL).write(s)
print("edited", p)

edit("autoresearch/README.md", [
    ("python tools/schedule.py show|next|set|reconcile|add [--command \"...\"]", "python tools/schedule.py show|next|set|add [--command \"...\"]    # item states are read from the run records"),
])
s = open("autoresearch/README.md", encoding="utf-8").read()
s = re.sub(r"python tools/tick\.py \[--dry-run\] \[--handover\].*", "python tools/tick.py [--dry-run]                       # start the ready items that have a command (gpu items when a slot is free); prints what runs", s)
s = s.replace("python tools/ledger.py add|note|render ...   |   python tools/ledger.py tail [--loop 19] [-n 15]   # the last rows, for a wake-up",
              "python tools/ledger.py add|note|render ...   |   ledger.py tail [--loop 19] [-n 15]   # last rows + runs in progress   |   ledger.py sync   # rows of finished runs that have none")
s = s.replace("| `ROADMAP.md` |", "| `history/` | the long roadmap and reviews of 2026-10-25 |\n| `ROADMAP.md` |", 1)
s = s.replace(" - being reworked under decision D8 (see `ROADMAP.md`) |", " |")
open("autoresearch/README.md", "w", encoding="utf-8", newline=NL).write(s)
print("edited autoresearch/README.md (tick line, ledger line, history row)")

edit("bev_fusion_lane_center/experiment_execution/README.md", [
    ("`autoresearch/tools/schedule.py show / next / reconcile / set / add`", "`autoresearch/tools/schedule.py show / next / set / add` (states of items with runs are read from the run records)"),
    ("reads HANDOVER, the schedule and the ledger, reconciles, advances", "reads HANDOVER, the schedule and the ledger (`schedule.py show`, `ledger.py tail`), advances"),
])
edit("bev_fusion_lane_center/CLAUDE.md", [
    ("`python3 ../autoresearch/tools/schedule.py show | next | reconcile`", "`python3 ../autoresearch/tools/schedule.py show | next`, item states are read from the run records"),
    ("reconcile and update the schedule, the ledger (", "read the state (`schedule.py show`, `ledger.py tail`) and update the ledger ("),
])
