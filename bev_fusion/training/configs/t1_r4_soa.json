{
  "name": "t1_r4_soa",
  "out_root": "runs",
  "data_root": "~/data/nuscenes_full",
  "version": "v1.0-trainval",
  "train_split": "train",
  "val_split": "val",
  "feature_cache": "data/cache/cam_feats",
  "gt_cache": "data/cache/gt",
  "radar_cache": "data/cache/radar",
  "n_cam": 3,
  "cam_stride": 2,
  "batch_size": 3,
  "accum": 2,
  "seq_len": 3,
  "seq_bptt": true,
  "workers": 8,
  "steps": 7000,
  "lr": 0.0003,
  "warmup": 300,
  "balancing": "kendall",
  "consistency": 0.0,
  "grad_diag_every": 500,
  "gap_ego": true,
  "weight_decay": 0.01,
  "grad_clip": 5.0,
  "ema": 0.999,
  "amp": "off",
  "log_every": 20,
  "eval_every": 1000,
  "eval_batches": 50,
  "save_every": 500,
  "keep": 3,
  "seed": 0,
  "flip_aug": 0.5,
  "device": "cuda",
  "model": {"trunk_width": 1.0, "trunk_detail": 32, "trunk_pretrained": "models/pretrained/dualbev-r50-cbgs.pth", "c_fuse": 80, "object_direction": true, "refine": false, "head_channels": 96},
  "loss": {"w_obj_vel": 1.0}
}
