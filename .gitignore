# One repository for code and text records; data and run outputs live where the machine file says (~/.research/machine.json), never here.
# Everything is ignored unless listed here.
/*
!/.gitignore
!/.gitattributes
!/CLAUDE.md
!/README.md
!/DECISIONS.md
!/.claude/
/.claude/*
!/.claude/settings.json
!/autoresearch/
!/GtGenerator/
!/datasets/
!/problems/
!/champions/

# scratch: never in git, anywhere
**/temp/**
**/_to_delete/**

# never, anywhere: caches, checkpoints, arrays, binaries
__pycache__/
*.py[cod]
*.pt
*.pth
*.ckpt
*.npy
*.npz
*.pkl
*.pickle
*.h5
*.png
*.jpg
*.jpeg
*.svg
*.mp4
*.gif
*.pdf
*.pptx
*.docx
*.xlsx
*.html
*.zip
*.tgz
*.gz
*.tar
*.7z
*.zst
*.bin
*.onnx
*.safetensors
*.parquet
*.sqlite
*.so
*.exe
*.tif
*.tiff
*.webp
*.avi
*.mat
~$*
*.tmp
*.lock
*.tmp.*
*.part
heartbeat

# drawings are text made by autoresearch/reporter/archdraw.py from the spec next to them
!**/training/architecture.svg
!champions/**/architecture.svg
