{
  "name": "t1_base",
  "out_root": "runs",
  "data_root": "~/data/nuscenes_full",
  "version": "v1.0-trainval",
  "train_split": "train",
  "val_split": "val",
  "feature_cache": "data/cache/cam_feats",
  "gt_cache": "data/cache/gt",
  "n_cam": 3,
  "cam_stride": 2,
  "batch_size": 2,
  "accum": 8,
  "workers": 2,
  "steps": 20000,
  "lr": 0.0003,
  "warmup": 500,
  "balancing": "kendall",
  "consistency": 0.0,
  "grad_diag_every": 500,
  "gap_ego": true,
  "weight_decay": 0.01,
  "grad_clip": 5.0,
  "ema": 0.999,
  "amp": "off",
  "log_every": 20,
  "eval_every": 1000,
  "eval_batches": 50,
  "save_every": 500,
  "keep": 3,
  "seed": 0,
  "device": "cuda",
  "model": {"trunk_width": 0.5},
  "loss": {}
}
