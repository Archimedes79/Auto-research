{
 "name": "bev_fusion",
 "tag_prefix": "bev_fusion",
 "python": "gcar",
 "config": "training/configs/base.json",
 "first_experiment": 27,
 "steps": {
  "train": {"run": ["{python}", "-P", "-m", "bev_fusion.training.train", "{config}"], "gpus": 1, "note": "trainkit; works in the problem's data folder (net/netpath.SITE)"},
  "import": {"run": ["{python}", "-P", "-m", "bev_fusion.tools.import_ckpt", "{config}"], "note": "a measurement of an existing network: its newest checkpoint copied into the run (config _import)"},
  "evaluate": {"run": "evaluate", "gpus": 1}
 },
 "default_steps": ["train", "evaluate"],
 "score": {"metric": "board.board7", "better": "higher", "band": 0.02},
 "guards": [
  {"metric": "seg.fov/dt+0.00/drivable_area/all/all/iou@0.5", "max_drop": 0.02},
  {"metric": "det.dt+0.00/mean/all/mAP", "max_drop": 0.02}
 ],
 "control_floor": {"board.board7": 0.3},
 "evaluate": {"split": "val", "frames": "spread:1000:val", "metrics": ["maps", "boxes", "board"], "device": "cuda", "anchor_tolerance": 0.003},
 "holdout": ["test"],
 "protected": ["problem.json", "PROBLEM.md", "splits/", "evaluation/metrics.py", "evaluation/bev_task.py", "evaluation/bev_eval.py"],
 "tests": ["bev_fusion.tests.test_net_layering", "bev_fusion.tests.test_chain", "bev_fusion.tests.test_layers", "bev_fusion.tests.test_splits",
           "bev_fusion.tests.test_evaluation_api", "bev_fusion.tests.test_trainkit_equivalence",
           "bev_fusion.tests.test_interface", "bev_fusion.tests.test_lift_pd", "bev_fusion.tests.test_splat", "bev_fusion.tests.test_temporal_fusion",
           "bev_fusion.tests.test_fusion", "bev_fusion.tests.test_bev_trunk",
           "bev_fusion.tests.test_timed_head", "bev_fusion.tests.test_object_head", "bev_fusion.tests.test_extract", "bev_fusion.tests.test_motion_block",
           "bev_fusion.tests.test_radar_bev", "bev_fusion.tests.test_radar_encoder",
           "bev_fusion.tests.test_lane_branch", "bev_fusion.tests.test_camera_encoder", "bev_fusion.tests.test_bevfusion_camera", "bev_fusion.tests.test_cached_model",
           "bev_fusion.tests.test_precompute",
           "bev_fusion.tests.test_images", "bev_fusion.tests.test_synthetic_world", "bev_fusion.tests.test_loss_extras", "bev_fusion.tests.test_losses",
           "bev_fusion.tests.test_metrics", "bev_fusion.tests.test_bev_sets", "bev_fusion.tests.test_bev_curves", "bev_fusion.tests.test_bev_errors",
           "bev_fusion.tests.test_bev_fusion_area", "bev_fusion.tests.test_bev_velocity",
           "bev_fusion.tests.test_bev_views", "bev_fusion.tests.test_bev_modules", "bev_fusion.tests.test_bev_timing",
           "bev_fusion.tests.test_nuscenes_dataset", "bev_fusion.tests.test_feature_cache", "bev_fusion.tests.test_gt_cache_build", "bev_fusion.tests.test_build_feature_cache",
           "bev_fusion.tests.test_cache_bevfusion_features", "bev_fusion.tests.test_augment", "bev_fusion.tests.test_model",
           "bev_fusion.tests.test_end_to_end --cpu --threads 2"],
 "note": "BEV Fusion: camera + radar BEV perception (map layers, objects, motion) on nuScenes; the score board7 = the mean of six map rows and the object mAP; the memory is carried (D70)"
}
