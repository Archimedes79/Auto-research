# One repository for code and text records; data and run outputs live where the machine file says (~/.research/machine.json), never here.
# Everything is ignored unless listed here.
/*
!/.gitignore
!/.gitattributes
!/CLAUDE.md
!/README.md
!/DECISIONS.md
!/.claude/
/.claude/*
!/.claude/settings.json
!/autoresearch/
!/GtGenerator/
!/datasets/
!/problems/
!/champions/

# literature: extractions of foreign code are made where they are needed and are not stored (the BEV ones are short own-word notes that the
# code cites, so they stay); the topic tables are generated
problems/lane_center/literature/code/*
!problems/lane_center/literature/code/README.md
!problems/lane_center/literature/code/_TEMPLATE.md
**/literature/topics/*/table*.md
**/literature/topics/*/table*.csv
**/literature/topics/*/*/skeleton.md

# scratch: never in git, anywhere
**/temp/**
**/_to_delete/**

# never, anywhere: caches, checkpoints, arrays, binaries
__pycache__/
*.py[cod]
*.pt
*.pth
*.ckpt
*.npy
*.npz
*.pkl
*.pickle
*.h5
*.png
*.jpg
*.jpeg
*.svg
*.mp4
*.gif
*.pdf
*.pptx
*.docx
*.xlsx
*.html
*.zip
*.tgz
*.gz
*.tar
*.7z
*.zst
*.bin
*.onnx
*.safetensors
*.parquet
*.sqlite
*.so
*.exe
*.tif
*.tiff
*.webp
*.avi
*.mat
~$*
*.tmp
*.lock
*.tmp.*
*.part
heartbeat

# drawings are text made by autoresearch/reporter/archdraw.py from the spec next to them
!**/training/architecture.svg
!champions/**/architecture.svg
# the scene names a tool writes next to a config (problems/bev_fusion/training/gt_scenes.py)
*.scenes.txt
# the drawings a report's author puts into its parts
!problems/*/reports/*/parts/*.svg
!problems/*/experiments/*/report/parts/*.svg
