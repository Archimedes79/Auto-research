# One repository for the research system and its problems: CODE + TEXT RECORDS + RECIPES (decisions of 2026-10-25, D11; rules: bev_fusion_lane_center/CLAUDE.md "Git").
# Test of the rules: wsl python3 bev_fusion_lane_center/tools/maintenance/reproducible.py (policy in bev_fusion_lane_center/data/rebuild.json).
# Everything is ignored unless listed here. Never: data, checkpoints, caches, binaries (images, videos, pdf, pptx, html), third-party code, wsl/.
/*
!/.gitignore
!/CLAUDE.md
# the gate hook (autoresearch/tools/guard_hook.py); the agent copies in .claude/agents/ are generated by install_agents.py
!/.claude/
/.claude/*
!/.claude/settings.json

# the general research system
!/autoresearch/
# what `python -m evalsuite` writes below autoresearch/ with the default --out (runs, pictures, stored counts: results, not code)
/autoresearch/eval_out/
# the machine lock between chats (D19, tools/machine_lock.py): runtime state, not a record
/autoresearch/state/

# the nuScenes ground-truth suite (code only): what it generates (stored GT, reports, videos) goes to /data/autogt/, scratch to /temp/ -
# both stay ignored by the first rule
!/autogt/

# problem: lane-centre-line graph + SD map (tag prefix lcr)
!/bev_fusion_lane_center/
/bev_fusion_lane_center/*
!/bev_fusion_lane_center/CLAUDE.md
!/bev_fusion_lane_center/README.md
!/bev_fusion_lane_center/PROBLEM.md
!/bev_fusion_lane_center/project.json
!/bev_fusion_lane_center/HANDOVER.md
# code
!/bev_fusion_lane_center/training/
!/bev_fusion_lane_center/evaluation/
!/bev_fusion_lane_center/tools/
!/bev_fusion_lane_center/reports/
/bev_fusion_lane_center/reports/*
!/bev_fusion_lane_center/reports/README.md
!/bev_fusion_lane_center/reports/build/
!/bev_fusion_lane_center/reports/source/
# text records: plan, schedule, ledger, decisions, closed questions, run records, history; experiment cards and summaries; model registry
!/bev_fusion_lane_center/experiment_execution/
!/bev_fusion_lane_center/experiments/
!/bev_fusion_lane_center/models/
/bev_fusion_lane_center/models/*
!/bev_fusion_lane_center/models/*.md
!/bev_fusion_lane_center/models/registry.json
# the split definition and the model configs and metric cards (needed to reproduce numbers); nothing else of data/ and runs/
!/bev_fusion_lane_center/data/
/bev_fusion_lane_center/data/*
!/bev_fusion_lane_center/data/README.md
!/bev_fusion_lane_center/data/rebuild.json
!/bev_fusion_lane_center/data/splits.json
!/bev_fusion_lane_center/data/splits_b456.json
!/bev_fusion_lane_center/runs/
/bev_fusion_lane_center/runs/*
!/bev_fusion_lane_center/runs/README.md
!/bev_fusion_lane_center/runs/eval/
!/bev_fusion_lane_center/runs/e123_ladder/
/bev_fusion_lane_center/runs/e123_ladder/*
!/bev_fusion_lane_center/runs/e123_ladder/cards/
# literature: the summaries (overview, catalogue, table, paper notes, deep extractions, register) but NOT the per-repository code extractions (code/<repo>.md,
# skeletons, clones): code is extracted on the fly by the process in literature/code/README.md
!/bev_fusion_lane_center/literature/
/bev_fusion_lane_center/literature/*
!/bev_fusion_lane_center/literature/README.md
!/bev_fusion_lane_center/literature/OVERVIEW.md
!/bev_fusion_lane_center/literature/CATALOGUE.md
!/bev_fusion_lane_center/literature/papers.csv
!/bev_fusion_lane_center/literature/register.md
!/bev_fusion_lane_center/literature/papers/
!/bev_fusion_lane_center/literature/deep/
!/bev_fusion_lane_center/literature/code/
/bev_fusion_lane_center/literature/code/*
!/bev_fusion_lane_center/literature/code/README.md
!/bev_fusion_lane_center/literature/code/_TEMPLATE.md
# scratch: never in an ordinary commit (`git add -A` does not sweep it in; autoresearch/tools/check_git.py refuses it before a push); a run's tag and clean_temp.py keep the scripts,
# because the launcher's snapshot adds the .py / .sh files of the scratch folder by force (run.py scratch_scripts)
!/bev_fusion_lane_center/temp/
/bev_fusion_lane_center/temp/**
!/bev_fusion_lane_center/temp/README.md

# not in git: wsl/ (the WSL disk image) and the raw data itself (nuScenes is on D:). In git: the description and the download / check tools of the raw data (recipes)
!/datasets/
/datasets/*
!/datasets/NuScenes/
/datasets/NuScenes/*
!/datasets/NuScenes/README.md
!/datasets/NuScenes/tools/
/datasets/NuScenes/tools/history/
# problem 2: camera + radar BEV: code and text records; runs (checkpoints, run snapshots, logs), caches and weights stay out
!/bev_fusion/
/bev_fusion/runs/*
!/bev_fusion/runs/README.md
# scratch of problem 2: not in git (as for the lane problem); only the two launch scripts that the snapshot lists in project.json fingerprint_extra stay in
/bev_fusion/temp/**
!/bev_fusion/temp/README.md
!/bev_fusion/temp/train/
/bev_fusion/temp/train/**
!/bev_fusion/temp/train/run_ar.sh
!/bev_fusion/temp/train/run_cfg.sh
# staged for deletion: the history of what was tracked stays, only the list (README.md) is a record
/bev_fusion/_to_delete/**
!/bev_fusion/_to_delete/README.md
/bev_fusion/data/*
!/bev_fusion/data/README.md
!/bev_fusion/data/scenes_parts1_6.json
/bev_fusion/models/pretrained/*
!/bev_fusion/models/pretrained/*.sha256

# never, anywhere: caches, checkpoints, arrays, binaries
__pycache__/
*.py[cod]
*.pt
*.pth
*.ckpt
*.npy
*.npz
*.pkl
*.pickle
*.h5
*.png
*.jpg
*.jpeg
*.svg
*.mp4
*.gif
*.pdf
*.pptx
*.docx
*.xlsx
*.html
*.zip
*.tgz
*.gz
~$*
*.tmp

# launcher state files (autoresearch/tools/run.py): locks, temporary writes, heartbeats, GPU slots
*.lock
*.lock.stale.*
*.tmp.*
heartbeat
.gpu_slots/
ledger_row.json
*_golden_check.json

# per-run temporary files (the records that count are run.json, the ledger row, the metric card and the experiment file; D11)
*.log
log.txt
stdout.txt
stderr.txt
status.json
*.done
*.done.FALSE

# the architecture drawings: text (SVG), generated by autoresearch/tools/archdraw.py from architecture.json next to them, checked against the code
# (`archdraw.py check`), embedded in the READMEs; the one exception to the image rule above
!/autoresearch/architecture.svg
!/autoresearch/history/architecture_target_2026-11-01.svg
!/bev_fusion/training/architecture.svg
!/bev_fusion/training/architecture_target.svg
!/bev_fusion/training/architecture_target.svg
!/bev_fusion_lane_center/training/architecture.svg
