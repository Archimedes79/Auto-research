{
 "name": "lane_center",
 "tag_prefix": "lane_center",
 "python": "gcar",
 "config": "training/configs/base.json",
 "first_experiment": 396,
 "steps": {
  "stage1": {"run": ["{python}", "-P", "-m", "lane_center.training.train.lane_train", "stage1", "{config}"], "gpus": 1, "dir": "stage1", "note": "the token head on the frozen lane head B' (jtoken_train, reads the token cache)"},
  "stage2": {"run": ["{python}", "-P", "-m", "lane_center.training.train.lane_train", "stage2", "{config}"], "gpus": 1, "dir": "stage2", "note": "the head and B''s node head trained together through the token loss (jlive_train)"},
  "predict": {"run": ["{python}", "-P", "-m", "lane_center.evaluation.lane_predict", "{config}"], "gpus": 1, "note": "the live dump of the run's network on the split: B' at batch 4 (its GPU parity), the head at batch 8"},
  "evaluate": {"run": "evaluate"}
 },
 "default_steps": ["predict", "evaluate"],
 "test_steps": ["predict", "evaluate"],
 "score": {"metric": "graph.topo_F1", "better": "higher", "band": 0.01},
 "guards": [
  {"metric": "graph.junction_F1", "max_drop": 0.01},
  {"metric": "graph.F1@1.0", "max_drop": 0.01},
  {"metric": "graph.lanes_found", "max_drop": 0.01},
  {"metric": "graph.dup_frac", "max_drop": 0.01},
  {"metric": "graph.vert100_dp", "max_drop": 1.0}
 ],
 "control_floor": {"graph.topo_F1": 0.5},
 "evaluate": {"split": "val", "metrics": ["graph", "cost"], "device": "cpu", "anchor_tolerance": 0},
 "holdout": ["test"],
 "protected": ["problem.json", "TEST_LOG.md", "PROBLEM.md", "data/splits.json", "evaluation/adapter.py", "evaluation/qgraph_eval.py", "evaluation/sparse_lanes/", "evaluation/lane_task/"],
 "data": "data/splits.json",
 "tests": ["lane_center.net.tests.test_net_layering", "lane_center.evaluation.tests.test_evaluator_hash", "lane_center.evaluation.sparse_lanes.selftest", "lane_center.evaluation.jtiming",
           "lane_center.net.tests.merged_source", "lane_center.net.tests.mutant selftest", "lane_center.net.tests.test_qmnms", "lane_center.net.tests.test_sections",
           "lane_center.net.tests.test_qgraph", "lane_center.net.tests.test_jtoken", "lane_center.net.tests.test_lane_tokcache", "lane_center.net.tests.test_lane_net",
           "lane_center.net.tests.test_jlive_train", "lane_center.net.tests.test_lane_train", "lane_center.net.tests.test_foundation", "lane_center.evaluation.tests.test_jtoken_eval"],
 "note": "Spurmitte: a lane-centre-line graph from camera + radar (GaussianCaR features), end to end differentiable; VAL 873 frames in 22 scenes, scored against the graph ground truth of B123"
}
