{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|mcp__.*__(write_file|edit_block|move_file|write_pdf)",
        "hooks": [
          {
            "type": "command",
            "command": "wsl.exe --cd \"$CLAUDE_PROJECT_DIR\" python3 autoresearch/tools/guard_hook.py || true",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
